     ],
     "label": "(0, -2)"
    },
    {
     "type": "point",
     "at": [
      2,
      1
     ],
     "label": "(2, 1)"
    }
   ]
  },
  "choices": [
   {
    "key": "A",
    "text": "$2$"
   },
   {
    "key": "B",
    "text": "$7$"
   },
   {
    "key": "C",
    "text": "$9$"
   },
   {
