 {
  "id": "algebra-linear-one-var-0002",
  "domain": "algebra",
  "skill": "linear equations in one variable",
  "difficulty": 2,
  "format": "spr",
  "stem": "$$\\frac{2}{3}(x + 4) = \\frac{1}{2}x + 5$$\n\nWhat value of $x$ satisfies the equation above?",
  "figure": null,
  "choices": null,
  "answer": {
   "accepted": [
    "14"
   ]
  },
  "solution": {
   "steps": [
    {
     "text": "Multiply both sides by 6 to clear the fractions.",
     "math": "4(x + 4) = 3x + 30"
    },
    {
     "text": "Distribute the 4.",
     "math": "4x + 16 = 3x + 30"
    },
    {
     "text": "Subtract $3x$ and 16 from both sides.",
     "math": "x = 14"
    }
   ],
   "desmos_tip": null
  },
  "status": "live",
  "version": 1
 },
 {
  "id": "algebra-linear-two-var-0001",
  "domain": "algebra",
  "skill": "linear equations in two variables",
  "difficulty": 1,
  "format": "mcq",
  "stem": "A bakery sells muffins for 3 dollars each and scones for 4 dollars each. On Saturday it took in 212 dollars from muffins and scones, and it sold 20 scones. How many muffins did it sell?",
  "figure": null,
  "choices": [
   {
    "key": "A",
    "text": "$38$"
   },
   {
    "key": "B",
    "text": "$44$"
   },
   {
    "key": "C",
    "text": "$64$"
   },
   {
    "key": "D",
    "text": "$192$"
   }
  ],
  "answer": {
   "key": "B"
  },
  "solution": {
   "steps": [
    {
     "text": "Write the total: 3 dollars per muffin times $m$ muffins, plus 4 dollars per scone times 20 scones.",
     "math": "3m + 4 \\cdot 20 = 212"
    },
    {
     "text": "The scones brought in 80 dollars, so subtract 80.",
     "math": "3m = 132"
    },
    {
     "text": "Divide by 3.",
     "math": "m = 44"
    }
   ],
   "desmos_tip": null
  },
  "status": "live",
  "version": 1
 },
 {
