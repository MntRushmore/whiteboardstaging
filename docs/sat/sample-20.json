 {
  "id": "advanced_math-nonlinear-equations-0002",
  "domain": "advanced_math",
  "skill": "nonlinear equations and systems",
  "difficulty": 3,
  "format": "mcq",
  "stem": "$$y = x^2 - 4x + 7$$\n$$y = 2x - 2$$\n\nHow many distinct real solutions $(x, y)$ does the system of equations above have?",
  "figure": null,
  "choices": [
   {
    "key": "A",
    "text": "Zero"
   },
   {
    "key": "B",
    "text": "Exactly one"
   },
   {
    "key": "C",
    "text": "Exactly two"
   },
   {
    "key": "D",
    "text": "Infinitely many"
   }
  ],
  "answer": {
   "key": "B"
  },
  "solution": {
   "steps": [
    {
     "text": "Set the two expressions for $y$ equal.",
     "math": "x^2 - 4x + 7 = 2x - 2"
    },
    {
     "text": "Move everything to one side.",
     "math": "x^2 - 6x + 9 = 0"
    },
    {
     "text": "This is a perfect square, so there is only one value of $x$.",
     "math": "(x - 3)^2 = 0, x = 3"
    },
    {
     "text": "One $x$ gives one point, $(3, 4)$: exactly one solution.",
     "math": null
    }
   ],
   "desmos_tip": "Graph both equations: the line just touches the parabola at (3, 4), so there is one intersection."
  },
  "status": "live",
  "version": 1
 },
 {
  "id": "advanced_math-nonlinear-functions-0001",
  "domain": "advanced_math",
  "skill": "nonlinear functions",
  "difficulty": 2,
  "format": "mcq",
  "stem": "The table shows four values of the exponential function $g$. Which equation defines $g$?",
  "figure": {
   "kind": "table",
   "headers": [
    "$x$",
    "$g(x)$"
   ],
   "rows": [
    [
     "0",
     "5"
    ],
    [
     "1",
     "15"
    ],
    [
     "2",
     "45"
    ],
    [
     "3",
     "135"
    ]
   ]
  },
  "choices": [
   {
    "key": "A",
    "text": "$g(x) = 5 \\cdot 3^x$"
   },
   {
    "key": "B",
    "text": "$g(x) = 3 \\cdot 5^x$"
   },
   {
    "key": "C",
    "text": "$g(x) = 10x + 5$"
   },
   {
    "key": "D",
    "text": "$g(x) = 5x^3$"
   }
  ],
  "answer": {
   "key": "A"
  },
  "solution": {
   "steps": [
    {
     "text": "When $x = 0$, $g(0) = 5$, so the starting value is 5.",
     "math": null
    },
    {
     "text": "Each time $x$ goes up by 1, the value is multiplied by 3: 15 is 5 times 3, 45 is 15 times 3.",
     "math": null
    },
    {
     "text": "So $g$ starts at 5 and triples each step.",
     "math": "g(x) = 5 \\cdot 3^x"
    }
   ],
   "desmos_tip": null
  },
  "status": "live",
  "version": 1
 },
 {
  "id": "advanced_math-nonlinear-functions-0002",
  "domain": "advanced_math",
  "skill": "nonlinear functions",
  "difficulty": 3,
  "format": "spr",
  "stem": "The graph of the quadratic function $y = f(x)$ is shown. Its vertex is $(1, 9)$ and it crosses the $x$-axis at $(4, 0)$. What is the value of $f(0)$?",
  "figure": {
   "kind": "plot",
   "x": {
    "min": -3,
    "max": 6,
    "step": 1,
    "label": "x"
   },
   "y": {
    "min": -3,
    "max": 10,
    "step": 1,
    "label": "y"
   },
   "grid": true,
   "items": [
    {
     "type": "function",
     "expr": "9-(x-1)**2"
    },
    {
     "type": "point",
     "at": [
      1,
      9
     ],
     "label": "(1, 9)"
    },
    {
     "type": "point",
     "at": [
      4,
      0
     ],
     "label": "(4, 0)"
    }
   ]
  },
  "choices": null,
  "answer": {
   "accepted": [
    "8"
   ]
  },
  "solution": {
   "steps": [
    {
     "text": "Write $f$ in vertex form.",
     "math": "f(x) = a(x - 1)^2 + 9"
    },
    {
     "text": "Use the point $(4, 0)$ to find $a$.",
     "math": "0 = 9a + 9, a = -1"
    },
    {
     "text": "Substitute $x = 0$.",
     "math": "f(0) = -(0 - 1)^2 + 9 = 8"
    }
   ],
   "desmos_tip": null
  },
  "status": "live",
  "version": 1
 },
 {
