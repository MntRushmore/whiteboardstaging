 {
  "id": "algebra-linear-systems-0001",
  "domain": "algebra",
  "skill": "systems of two linear equations",
  "difficulty": 2,
  "format": "spr",
  "stem": "$$x + 2y = 11$$\n$$3x - y = 5$$\n\nIf $(x, y)$ is the solution to the system of equations above, what is the value of $x + y$?",
  "figure": null,
  "choices": null,
  "answer": {
   "accepted": [
    "7"
   ]
  },
  "solution": {
   "steps": [
    {
     "text": "Solve the second equation for $y$.",
     "math": "y = 3x - 5"
    },
    {
     "text": "Substitute into the first equation.",
     "math": "x + 2(3x - 5) = 11"
    },
    {
     "text": "Simplify and solve.",
     "math": "7x = 21, x = 3"
    },
    {
     "text": "Find $y$, then add.",
     "math": "y = 4, x + y = 7"
    }
   ],
   "desmos_tip": "Graph both lines and tap the point where they cross: (3, 4). Then add the coordinates."
  },
  "status": "live",
  "version": 1
 },
 {
  "id": "algebra-linear-inequalities-0001",
  "domain": "algebra",
  "skill": "linear inequalities",
  "difficulty": 2,
  "format": "spr",
  "stem": "A delivery van can carry at most 1,250 kilograms, including its driver. The driver weighs 80 kilograms, and each box weighs 35 kilograms. What is the greatest number of boxes the van can carry on one trip with the driver?",
  "figure": null,
  "choices": null,
  "answer": {
   "accepted": [
    "33"
   ]
  },
  "solution": {
   "steps": [
    {
     "text": "Write the weight limit as an inequality, with $b$ boxes.",
     "math": "35b + 80 \\le 1250"
    },
    {
     "text": "Subtract 80.",
     "math": "35b \\le 1170"
    },
    {
     "text": "Divide by 35: $\\frac{1170}{35}$ is a little more than 33.4.",
     "math": "b \\le \\frac{1170}{35}"
    },
    {
     "text": "The number of boxes is a whole number, so round down: 33 boxes.",
     "math": null
    }
   ],
   "desmos_tip": null
  },
  "status": "live",
  "version": 1
 },
 {
  "id": "advanced_math-equivalent-expressions-0001",
  "domain": "advanced_math",
  "skill": "equivalent expressions",
  "difficulty": 1,
  "format": "mcq",
  "stem": "Which expression is equivalent to $(2x + 3)(x - 4)$?",
  "figure": null,
  "choices": [
   {
    "key": "A",
    "text": "$2x^2 - 12$"
   },
   {
    "key": "B",
    "text": "$2x^2 - 11x - 12$"
   },
   {
    "key": "C",
    "text": "$2x^2 - 5x - 12$"
   },
   {
    "key": "D",
    "text": "$2x^2 + 5x - 12$"
   }
  ],
  "answer": {
   "key": "C"
  },
  "solution": {
   "steps": [
    {
     "text": "Multiply each term of the first factor by each term of the second.",
     "math": "2x \\cdot x + 2x(-4) + 3x + 3(-4)"
    },
    {
     "text": "Simplify each product.",
     "math": "2x^2 - 8x + 3x - 12"
    },
    {
     "text": "Combine the like terms.",
     "math": "2x^2 - 5x - 12"
    }
   ],
   "desmos_tip": null
  },
  "status": "live",
  "version": 1
 },
 {
  "id": "advanced_math-equivalent-expressions-0002",
  "domain": "advanced_math",
  "skill": "equivalent expressions",
  "difficulty": 3,
  "format": "mcq",
  "stem": "Which of the following is equivalent to $\\frac{x^2 - 9}{x^2 + 5x + 6}$ for $x > 0$?",
  "figure": null,
  "choices": [
   {
    "key": "A",
    "text": "$\\frac{x + 3}{x + 2}$"
   },
   {
    "key": "B",
    "text": "$\\frac{-3}{5x + 2}$"
   },
   {
    "key": "C",
    "text": "$\\frac{x - 3}{x + 3}$"
   },
   {
    "key": "D",
    "text": "$\\frac{x - 3}{x + 2}$"
   }
  ],
  "answer": {
   "key": "D"
  },
  "solution": {
   "steps": [
    {
     "text": "Factor the top as a difference of squares.",
     "math": "x^2 - 9 = (x - 3)(x + 3)"
    },
    {
     "text": "Factor the bottom.",
     "math": "x^2 + 5x + 6 = (x + 2)(x + 3)"
    },
    {
     "text": "Cancel the common factor $x + 3$, which is never 0 when $x > 0$.",
     "math": "\\frac{x - 3}{x + 2}"
    }
   ],
   "desmos_tip": null
  },
  "status": "live",
  "version": 1
 },
 {
