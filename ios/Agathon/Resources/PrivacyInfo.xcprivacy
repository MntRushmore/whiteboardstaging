<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Agathon tracks nobody: no ads, no ad network, no data broker, no IDFA, no tracking domains. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- What the app collects (sent to Agathon's server and kept). Kept in step with App Store
	     Connect's App Privacy answers: docs/APP-STORE-LAUNCH.md, "App Privacy". -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- Required-reason APIs (scanned 2026-10-21 in the app, its packages and supabase-swift; the
	     Release binary's imports checked with nm/strings). swift-crypto ships its own manifest. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults.standard, the app's own settings only (no app group): the onboarding's
		     progress, the board's tool and Live settings, Ask's voice, App Attest's key id. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- CACurrentMediaTime (mach time): elapsed time between events inside the app only (the
		     tutor's handwriting pace, pen timing, render timings); never sent to identify a device. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
