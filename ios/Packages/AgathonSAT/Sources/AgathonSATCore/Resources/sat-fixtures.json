  "note": "Original SAT-style questions written for the iPad lane's previews and tests (docs/SAT-MODE.md). Not College Board items. Every answer was solved by hand; the unit tests check each again.",
  "questions": [
    {
      "id": "algebra-linear-one-var-9001",
      "domain": "algebra",
      "skill": "linear equations in one variable",
      "difficulty": 1,
      "format": "mcq",
      "stem": "If $4(x - 3) + 7 = 2x + 9$, what is the value of $x$?",
      "figure": null,
      "choices": [
        { "key": "A", "text": "$2$" },
        { "key": "B", "text": "$5$" },
        { "key": "C", "text": "$7$" },
        { "key": "D", "text": "$14$" }
      ],
      "answer": { "key": "C" },
      "solution": {
        "steps": [
          { "text": "Distribute the 4 and combine the numbers on the left.", "math": "4x - 12 + 7 = 2x + 9 \\Rightarrow 4x - 5 = 2x + 9" },
          { "text": "Subtract $2x$ from both sides and add 5.", "math": "2x = 14" },
          { "text": "Divide both sides by 2.", "math": "x = 7" }
        ],
        "desmos_tip": "Graph $y = 4(x - 3) + 7$ and $y = 2x + 9$. The lines cross where $x = 7$."
      },
      "status": "live",
      "version": 1
    },
    {
      "id": "algebra-linear-functions-9002",
      "domain": "algebra",
      "skill": "linear functions",
      "difficulty": 2,
      "format": "mcq",
      "stem": "The table shows three values of the linear function $f$. Which equation defines $f$?",
      "figure": { "kind": "table", "headers": ["$x$", "$f(x)$"], "rows": [["0", "-3"], ["2", "1"], ["5", "7"]] },
      "choices": [
        { "key": "A", "text": "$f(x) = 2x - 3$" },
        { "key": "B", "text": "$f(x) = 2x + 3$" },
        { "key": "C", "text": "$f(x) = 3x - 3$" },
        { "key": "D", "text": "$f(x) = \\frac{1}{2}x - 3$" }
      ],
      "answer": { "key": "A" },
      "solution": {
        "steps": [
          { "text": "The value at $x = 0$ is the $y$-intercept.", "math": "f(0) = -3" },
          { "text": "The slope is the change in $f(x)$ over the change in $x$.", "math": "m = \\frac{1 - (-3)}{2 - 0} = 2" },
          { "text": "Check with the last row.", "math": "2(5) - 3 = 7" }
        ],
        "desmos_tip": "Type the table into Desmos, then type $y_1 \\sim mx_1 + b$ to fit a line: $m = 2$, $b = -3$."
      },
      "status": "live",
      "version": 1
    },
    {
      "id": "algebra-linear-systems-9003",
      "domain": "algebra",
      "skill": "systems of two linear equations",
      "difficulty": 2,
      "format": "spr",
      "stem": "$$3x + 2y = 16$$\n$$x - y = 2$$\nThe solution to the system of equations above is $(x, y)$. What is the value of $x$?",
      "figure": null,
      "choices": null,
      "answer": { "accepted": ["4"] },
      "solution": {
        "steps": [
          { "text": "Solve the second equation for $x$.", "math": "x = y + 2" },
          { "text": "Substitute into the first equation.", "math": "3(y + 2) + 2y = 16 \\Rightarrow 5y + 6 = 16" },
          { "text": "So $y = 2$, and then $x$ follows.", "math": "x = 2 + 2 = 4" }
        ],
        "desmos_tip": "Graph both equations as written. Tap the point where they cross: $(4, 2)$."
      },
      "status": "live",
      "version": 1
    },
    {
      "id": "algebra-linear-two-var-9004",
      "domain": "algebra",
      "skill": "linear equations in two variables",
      "difficulty": 2,
      "format": "mcq",
      "stem": "The line shown in the $xy$-plane passes through the two labeled points. Which equation represents the line?",
      "figure": {
        "kind": "plot",
        "x": { "min": -2, "max": 5, "step": 1, "label": "x" },
        "y": { "min": -2, "max": 6, "step": 1, "label": "y" },
        "grid": true,
        "items": [
          { "type": "function", "expr": "-2*x+4" },
          { "type": "point", "at": [0, 4], "label": "(0, 4)" },
          { "type": "point", "at": [2, 0], "label": "(2, 0)" }
        ]
      },
      "choices": [
        { "key": "A", "text": "$2x + y = 4$" },
        { "key": "B", "text": "$x + 2y = 4$" },
        { "key": "C", "text": "$2x - y = 4$" },
        { "key": "D", "text": "$x - 2y = -4$" }
      ],
      "answer": { "key": "A" },
      "solution": {
        "steps": [
          { "text": "Find the slope from the two points.", "math": "m = \\frac{0 - 4}{2 - 0} = -2" },
          { "text": "The line crosses the $y$-axis at 4.", "math": "y = -2x + 4" },
          { "text": "Add $2x$ to both sides to match a choice.", "math": "2x + y = 4" }
        ],
        "desmos_tip": "Graph each choice. Only $2x + y = 4$ goes through both $(0, 4)$ and $(2, 0)$."
      },
      "status": "live",
      "version": 1
    },
    {
      "id": "geometry_trig-right-triangles-trig-9005",
      "domain": "geometry_trig",
      "skill": "right triangles and trigonometry",
      "difficulty": 2,
      "format": "mcq",
      "stem": "In right triangle $ABC$, angle $C$ is a right angle, $AC = 8$, and $BC = 6$. What is the value of $\\sin A$?",
      "figure": {
        "kind": "shape",
        "items": [
          { "type": "polygon", "points": [[0, 0], [8, 0], [0, 6]] },
          { "type": "right_angle", "at": [0, 0], "dirs": [[1, 0], [0, 1]] },
          { "type": "label", "at": [-0.5, -0.5], "text": "$C$" },
          { "type": "label", "at": [8.5, -0.5], "text": "$A$" },
          { "type": "label", "at": [-0.5, 6.4], "text": "$B$" },
          { "type": "label", "at": [4, -0.7], "text": "$8$" },
          { "type": "label", "at": [-0.7, 3], "text": "$6$" }
        ],
        "note": "Note: Figure not drawn to scale."
      },
      "choices": [
        { "key": "A", "text": "$\\frac{3}{5}$" },
        { "key": "B", "text": "$\\frac{4}{5}$" },
        { "key": "C", "text": "$\\frac{3}{4}$" },
        { "key": "D", "text": "$\\frac{4}{3}$" }
      ],
      "answer": { "key": "A" },
      "solution": {
        "steps": [
          { "text": "Find the hypotenuse with the Pythagorean theorem.", "math": "AB = \\sqrt{8^2 + 6^2} = 10" },
          { "text": "Sine is the opposite side over the hypotenuse. The side opposite $A$ is $BC$.", "math": "\\sin A = \\frac{6}{10} = \\frac{3}{5}" }
        ],
        "desmos_tip": null
      },
      "status": "live",
      "version": 1
    },
    {
      "id": "psda-ratios-rates-9006",
      "domain": "psda",
      "skill": "ratios, rates, proportions, units",
      "difficulty": 1,
      "format": "spr",
      "stem": "A pancake recipe uses 3 cups of flour for every 4 cups of milk. At this rate, how many cups of flour are used with 1 cup of milk?",
      "figure": null,
      "choices": null,
      "answer": { "accepted": ["3/4", ".75", "0.75"] },
      "solution": {
        "steps": [
          { "text": "Write the ratio of flour to milk.", "math": "\\frac{3}{4} = \\frac{f}{1}" },
          { "text": "So there are three quarters of a cup of flour for each cup of milk.", "math": "f = \\frac{3}{4} = 0.75" }
        ],
        "desmos_tip": null
      },
      "status": "live",
      "version": 1
    },
    {
      "id": "advanced_math-nonlinear-functions-9007",
      "domain": "advanced_math",
      "skill": "nonlinear functions",
      "difficulty": 2,
      "format": "mcq",
      "stem": "The graph of $y = f(x)$ is shown, where $f(x) = x^2 - 2x - 3$. What is the minimum value of $f(x)$?",
      "figure": {
        "kind": "plot",
        "x": { "min": -3, "max": 5, "step": 1, "label": "x" },
        "y": { "min": -5, "max": 6, "step": 1, "label": "y" },
        "grid": true,
        "items": [{ "type": "function", "expr": "x**2 - 2*x - 3" }]
      },
      "choices": [
        { "key": "A", "text": "$-4$" },
        { "key": "B", "text": "$-3$" },
        { "key": "C", "text": "$1$" },
        { "key": "D", "text": "$3$" }
      ],
      "answer": { "key": "A" },
      "solution": {
        "steps": [
          { "text": "A parabola that opens up is lowest at its vertex, halfway between its zeros.", "math": "x^2 - 2x - 3 = (x - 3)(x + 1)" },
          { "text": "The zeros are $-1$ and $3$, so the vertex is at $x = 1$.", "math": "f(1) = 1 - 2 - 3 = -4" }
        ],
        "desmos_tip": "Graph $y = x^2 - 2x - 3$ and tap the lowest point: $(1, -4)$."
      },
      "status": "live",
      "version": 1
    },
