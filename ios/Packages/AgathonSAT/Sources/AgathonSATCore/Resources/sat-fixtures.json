    {
      "id": "geometry_trig-circles-9010",
      "domain": "geometry_trig",
      "skill": "circles",
      "difficulty": 3,
      "format": "spr",
      "stem": "In the circle with center $O$, chord $\\overline{PQ}$ has length 8, and the distance from $O$ to the chord is 3. What is the radius of the circle?",
      "figure": {
        "kind": "shape",
        "items": [
          { "type": "circle", "center": [0, 0], "r": 5 },
          { "type": "segment", "from": [-4, -3], "to": [4, -3] },
          { "type": "segment", "from": [0, 0], "to": [0, -3], "dashed": true },
          { "type": "right_angle", "at": [0, -3], "dirs": [[1, 0], [0, 1]] },
          { "type": "point", "at": [0, 0], "label": "$O$" },
          { "type": "label", "at": [-4.6, -3.6], "text": "$P$" },
          { "type": "label", "at": [4.6, -3.6], "text": "$Q$" },
          { "type": "label", "at": [-0.5, -1.5], "text": "$3$" }
        ]
      },
      "choices": null,
      "answer": { "accepted": ["5"] },
      "solution": {
        "steps": [
          { "text": "The perpendicular from the center cuts the chord in half, so each half is 4.", "math": "\\frac{8}{2} = 4" },
          { "text": "The radius to $Q$ is the hypotenuse of a right triangle with legs 3 and 4.", "math": "r = \\sqrt{3^2 + 4^2} = 5" }
        ],
        "desmos_tip": null
      },
      "status": "live",
      "version": 1
    },
