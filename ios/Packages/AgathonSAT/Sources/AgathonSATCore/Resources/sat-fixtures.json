    {
      "id": "advanced_math-equivalent-expressions-9012",
      "domain": "advanced_math",
      "skill": "equivalent expressions",
      "difficulty": 2,
      "format": "mcq",
      "stem": "Which expression is equivalent to $(2x + 3)^2 - 4x^2$?",
      "figure": null,
      "choices": [
        { "key": "A", "text": "$9$" },
        { "key": "B", "text": "$12x + 9$" },
        { "key": "C", "text": "$6x + 9$" },
        { "key": "D", "text": "$8x^2 + 12x + 9$" }
      ],
      "answer": { "key": "B" },
      "solution": {
        "steps": [
          { "text": "Expand the square.", "math": "(2x + 3)^2 = 4x^2 + 12x + 9" },
          { "text": "Subtract $4x^2$.", "math": "4x^2 + 12x + 9 - 4x^2 = 12x + 9" }
        ],
        "desmos_tip": "Graph $y = (2x + 3)^2 - 4x^2$ and each choice. The right one lies exactly on top of it."
      },
      "status": "live",
      "version": 1
