          { "type": "arc_angle", "at": [6, 0], "from": 0, "to": 135, "label": "$130^\\circ$" },
          { "type": "arc_angle", "at": [2, 4], "from": 243.4, "to": 315, "label": "$x^\\circ$" },
          { "type": "label", "at": [-0.4, -0.5], "text": "$A$" },
          { "type": "label", "at": [6, -0.6], "text": "$B$" },
          { "type": "label", "at": [9.3, -0.5], "text": "$D$" }
        ],
        "note": "Note: Figure not drawn to scale."
      },
      "choices": [
        { "key": "A", "text": "$55$" },
        { "key": "B", "text": "$65$" },
