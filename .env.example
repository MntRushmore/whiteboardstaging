# Copy to .env.local for local development. Never commit .env.local.
#
# Conventions
#   - Values below are real defaults for the LOCAL Supabase stack (`npx supabase start`)
#     and placeholders everywhere else. Placeholders (`your-...`, `sk-or-...`, empty)
#     are treated as "unset" by src/lib/env.ts, so a half-filled file fails loudly.
#   - Variables without the NEXT_PUBLIC_ prefix are server-only (route handlers, scripts)
#     and never reach the browser bundle.
#   - Cloud/Vercel values and dashboard settings: docs/RUNBOOK-supabase.md.
#   - src/__tests__/envExample.test.ts fails if code references a variable missing here.

# ─── Required (the app refuses to serve /api/* without these) ─────────────────

# Supabase project URL. Used by: src/lib/supabase.ts (browser client),
# src/lib/env.ts + src/lib/server/** (JWT verification), scripts/live-smoke.mjs.
# Local: `npx supabase status -o env` -> API_URL. Cloud: Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (publishable) key. Same users as above. Safe to expose: RLS does the work.
# The value below is the well-known demo key every local `supabase start` issues.
# Cloud: Dashboard -> Project Settings -> API Keys -> anon / publishable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# OpenRouter API key. Used by: src/lib/env.ts, src/lib/server/openrouter.ts, every AI route
# (generate-solution, generate-worksheet, ocr, live/*, credits). https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ─── Optional providers ──────────────────────────────────────────────────────

# OpenAI: voice tutor only (Realtime API over WebRTC). Used by: src/lib/env.ts,
# src/app/api/voice/token. Empty -> /api/voice/token returns 503 voice_unavailable.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Mathpix: handwritten math -> LaTeX (legacy OCR and Live recognize). Used by:
# src/lib/env.ts (hasMathpix). Both empty -> vision-model fallback. https://mathpix.com
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Supabase service role key. Server-only. Declared optional in src/lib/env.ts. Read by TWO
# request paths, neither user-facing: POST /api/billing/webhook (plan changes after signature
# verification; 503 without it) and GET|POST /api/admin/gc (storage GC behind CRON_SECRET; 503
# without it), plus the admin scripts (scripts/offload-assets.mjs, scripts/gc-storage.mjs).
# Local value: `npx supabase status -o env` -> SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the nightly storage GC cron (vercel.json "crons" -> /api/admin/gc).
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`; the route answers 401 without a
# match and 503 when this is empty. Used by: src/lib/server/storageGc.ts. Any random string
# (>= 16 chars recommended); also needs SUPABASE_SERVICE_ROLE_KEY. docs/RUNBOOK-supabase.md §12.
CRON_SECRET=

# tldraw license key (removes the watermark; host-bound). Used by:
# src/app/board/[id]/page.tsx, src/app/train/page.tsx. Empty is fine for development.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Public origin of this deployment, sent as HTTP-Referer to OpenRouter.
# Used by: src/lib/aiConfig.ts. Default http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Logging ─────────────────────────────────────────────────────────────────

# Server pino level (route handlers): trace | debug | info | warn | error | fatal.
# Used by: src/lib/logger.ts. Default info.
LOG_LEVEL=info

# Browser pino level (console output + bug-report ring buffer). Same values.
# Used by: src/lib/logger.ts (client branch). Default info.
NEXT_PUBLIC_LOG_LEVEL=info

# ─── Live Math (realtime math & STEM layer) ──────────────────────────────────

# Set to 0 to hide the Live pipeline/UI (shape utils stay registered so saved boards load).
# Used by: src/lib/live/contracts.ts (LIVE_KILL_SWITCH). Default on.
NEXT_PUBLIC_LIVE_MATH=1

# Optional model overrides (OpenRouter ids). Used by: src/lib/env.ts (getLiveModels).
# Empty -> defaults from LIVE_MODELS in src/lib/live/contracts.ts.
LIVE_MODEL_CHECK=
LIVE_MODEL_SOLVE=
LIVE_MODEL_VISION=

# ─── Rate limiting ───────────────────────────────────────────────────────────

# Where per-user rate-limit counters live. db (default, anything but "memory"): shared fixed
# window in Postgres via the rate_limit_hit RPC (migration 20260917030000_refunds_ratelimit.sql),
# one budget across every server instance; when the RPC is missing or errors the route falls back
# to the in-memory limiter (logged once per process). memory: per-instance sliding window only.
# Public IP-keyed buckets (config/status, billing/webhook) are always in memory.
# Used by: src/lib/env.ts (getRateLimitBackend), src/lib/server/rate-limit.ts, scripts/live-smoke.mjs.
RATE_LIMIT_BACKEND=db

# ─── Managed by the Vercel Supabase integration (do not set by hand) ─────────
# `vercel integration add supabase` provisions the project and injects these into all three
# Vercel environments. The app reads only NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY (above) and
# SUPABASE_SERVICE_ROLE_KEY; the rest are the integration's standard set, listed here so
# `npm run env:check` recognises them instead of reporting drift. Locally you do not need any
# of them — `npx supabase start` covers development. Never commit real values.
# Aliases of the two public values (same project, different names):
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Secrets. SUPABASE_SECRET_KEY is the newer name for the service role key; SUPABASE_JWT_SECRET
# signs user tokens — neither is read by this app's code, but the integration sets both.
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
# Direct Postgres access, used by `supabase db push --db-url` and psql, not by the app.
# POSTGRES_URL_NON_POOLING is the one to use for migrations (DDL needs a session connection).
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ─── Scripts and tests (never needed by the deployed app) ────────────────────

# scripts/live-smoke.mjs: dev server origin to smoke-test. Default http://localhost:3113.
BASE_URL=http://localhost:3000

# scripts/live-smoke.mjs: credentials of a throwaway local user (created on first run).
# Defaults qa-student@example.com / password123. Only ever point these at a LOCAL stack.
SMOKE_EMAIL=qa-student@example.com
SMOKE_PASSWORD=password123

# scripts/live-smoke.mjs: set to 1 to skip the check/solve LLM streams (no OpenRouter spend).
SMOKE_SKIP_LLM=1

# Set to 1 to run the database/RLS integration tests in `npm test` against the local
# stack (they are skipped otherwise). Also see `npm run db:verify`.
RUN_DB_TESTS=

# scripts/verify-rls.mjs: email domain for the two throwaway users it signs up. Default example.com.
VERIFY_EMAIL_DOMAIN=

# ─── Billing (credits + plans; all optional) ─────────────────────────────────
# Design: docs/ARCHITECTURE.md "Billing". Plan numbers in the migration are PLACEHOLDERS.

# Set to 0 to skip credit consumption on the server (dev/staging escape hatch; logged once).
# Anything else, including unset, meters every paid route. Used by: src/lib/env.ts (billingEnforced),
# src/lib/server/billing.ts. Default 1.
BILLING_ENFORCE=1

# Signing secret of the billing provider's webhook endpoint (Stripe-compatible
# `Stripe-Signature: t=…,v1=…`). Used by: src/app/api/billing/webhook. Empty -> the
# webhook answers 503 feature_unavailable. NOTE: the webhook also needs SUPABASE_SERVICE_ROLE_KEY
# (above) to change plans; the only other request path using the service role is /api/admin/gc.
STRIPE_WEBHOOK_SECRET=

# JSON map from provider price id to plan id, e.g. {"price_123":"plus","price_456":"pro"}.
# Used by: src/lib/env.ts (getBillingPriceMap), src/app/api/billing/webhook. Empty -> plans
# come only from checkout metadata.plan_id. Invalid JSON -> the webhook answers 503.
BILLING_PRICE_MAP=

# JSON with checkout links per plan id plus the customer portal, e.g.
# {"plus":"https://buy.stripe.com/…","pro":"https://buy.stripe.com/…","portal":"https://billing.stripe.com/…"}.
# Public: read by the /account page and the 402 `upgradeUrl`. Empty -> plans show "Coming soon".
# Used by: src/lib/env.ts (getBillingLinks), src/lib/billing/viewModel.ts.
NEXT_PUBLIC_BILLING_LINKS=
