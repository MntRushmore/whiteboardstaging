# Copy to .env.local for local development. Never commit .env.local.
#
# Conventions
#   - Values below are real defaults for the LOCAL Supabase stack (`npx supabase start`)
#     and placeholders everywhere else. Placeholders (`your-...`, `sk-or-...`, empty)
#     are treated as "unset" by src/lib/env.ts, so a half-filled file fails loudly.
#   - Variables without the NEXT_PUBLIC_ prefix are server-only (route handlers, scripts)
#     and never reach the browser bundle.
#   - Cloud/Vercel values and dashboard settings: docs/RUNBOOK-supabase.md.
#   - src/__tests__/envExample.test.ts fails if code references a variable missing here.

# ─── Required (the app refuses to serve /api/* without these) ─────────────────

# Supabase project URL. Used by: src/lib/supabase.ts (browser client),
# src/lib/env.ts + src/lib/server/** (JWT verification), scripts/live-smoke.mjs.
# Local: `npx supabase status -o env` -> API_URL. Cloud: Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (publishable) key. Same users as above. Safe to expose: RLS does the work.
# Local: `npx supabase status -o env` prints ANON_KEY (the same well-known demo key on every
# machine). Cloud: Dashboard -> Project Settings -> API Keys -> anon / publishable.
# Deliberately a placeholder, not the real demo JWT: a committed token (even a public one)
# trips secret scanners on every pull request, and a scanner people learn to ignore is worse
# than no scanner. `npm run db:seed` prints the line to paste for local development.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenRouter API key. Used by: src/lib/env.ts, src/lib/server/openrouter.ts, every AI route
# (live/*, credits). https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ─── Optional providers ──────────────────────────────────────────────────────

# Mathpix: handwritten math -> LaTeX (legacy OCR and Live recognize). Used by:
# src/lib/env.ts (hasMathpix). Both empty -> vision-model fallback. https://mathpix.com
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ElevenLabs: lecture mode's realtime speech-to-text (Scribe), through single-use tokens minted by
# POST /api/live/lecture/token. Used by: src/lib/env.ts (hasElevenLabs). Empty -> the browser's own
# recognizer (Chrome/Edge/Safari). https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Supabase service role key. Server-only. Declared optional in src/lib/env.ts. Read by TWO
# request paths, neither user-facing: POST /api/billing/webhook (plan changes after signature
# verification; 503 without it) and GET|POST /api/admin/gc (storage GC behind CRON_SECRET; 503
# without it), plus the admin scripts (scripts/offload-assets.mjs, scripts/gc-storage.mjs).
# Local value: `npx supabase status -o env` -> SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the nightly storage GC cron (vercel.json "crons" -> /api/admin/gc).
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`; the route answers 401 without a
# match and 503 when this is empty. Used by: src/lib/server/storageGc.ts. Any random string
# (>= 16 chars recommended); also needs SUPABASE_SERVICE_ROLE_KEY. docs/RUNBOOK-supabase.md §12.
CRON_SECRET=

# tldraw license key (removes the watermark; host-bound). Used by:
# src/app/board/[id]/page.tsx, src/app/train/page.tsx. Empty is fine for development.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Public origin of this deployment, sent as HTTP-Referer to OpenRouter.
# Used by: src/lib/aiConfig.ts. Default http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Logging ─────────────────────────────────────────────────────────────────

# Server pino level (route handlers): trace | debug | info | warn | error | fatal.
# Used by: src/lib/logger.ts. Default info.
LOG_LEVEL=info

# Browser pino level (console output + bug-report ring buffer). Same values.
# Used by: src/lib/logger.ts (client branch). Default info.
NEXT_PUBLIC_LOG_LEVEL=info

# The release name on error reports, server error lines and /api/health. Leave unset: next.config.ts
# fills it at build time from VERCEL_GIT_COMMIT_SHA (7 chars), else the local git HEAD.
# Used by: src/lib/release.ts. See docs/RUNBOOK-ops.md.
# NEXT_PUBLIC_RELEASE=

# ─── Live Math (realtime math & STEM layer) ──────────────────────────────────

# Set to 0 to hide the Live pipeline/UI (shape utils stay registered so saved boards load).
# Used by: src/lib/live/contracts.ts (LIVE_KILL_SWITCH). Default on.
NEXT_PUBLIC_LIVE_MATH=1

# Optional model overrides (OpenRouter ids). Used by: src/lib/env.ts (getLiveModels).
# Empty -> defaults from LIVE_MODELS in src/lib/live/contracts.ts.
LIVE_MODEL_CHECK=
LIVE_MODEL_SOLVE=
LIVE_MODEL_VISION=
# Word problem -> equations (POST /api/live/setup; default openai/gpt-5.4-mini, fallback deepseek/deepseek-v4.1-flash).
LIVE_MODEL_SETUP=
# Second reader for messy ink (POST /api/live/reread; default google/gemini-3.1-flash-lite, fallback anthropic/claude-haiku-4.5).
LIVE_MODEL_REREAD=
# A hand-drawn figure read as facts -> equations (POST /api/live/setup with a crop; also fires unasked in Solve).
# Default google/gemini-3.1-flash-lite, fallback google/gemini-3.5-flash-lite: chosen on `npm run eval:figures`
# (docs/eval/figures.md: 47/47 and 45/47 of 47 hand-drawn figures). Any OpenRouter vision model id works here.
LIVE_MODEL_FIGURE=
# Two-column proofs: a proof's figure read, and a next row when the engine's planner cannot finish
# (POST /api/live/proof; default openai/gpt-5.4-mini, fallback deepseek/deepseek-v4.1-flash).
LIVE_MODEL_PROOF=
# The board chat: a typed request ("5 two-step equations", "graph y = sin x") -> a reply and the
# actions the tutor writes (POST /api/live/chat; default openai/gpt-5.4-mini, fallback deepseek/deepseek-v4.1-flash).
LIVE_MODEL_CHAT=
# Lecture mode's director (POST /api/live/lecture): recent transcript -> what to sketch.
LIVE_MODEL_LECTURE=
# Lecture mode's illustrator (POST /api/live/lecture/sketch): a panel described in words -> vector ink.
LIVE_MODEL_SKETCH=

# 1 = send the raw recognizer output (Mathpix JSON) with /api/live/recognize in a production
# build too, for the board's "Mathpix" debug panel. Always on in development. The panel itself
# also needs localStorage["agathon.liveDebug"] = "1" in a production build.
# Used by: src/lib/server/live-route.ts (liveDebugEnabled). Default off.
LIVE_DEBUG=

# ─── Rate limiting ───────────────────────────────────────────────────────────

# Where per-user rate-limit counters live. db (default, anything but "memory"): shared fixed
# window in Postgres via the rate_limit_hit RPC (migration 20260917030000_refunds_ratelimit.sql),
# one budget across every server instance; when the RPC is missing or errors the route falls back
# to the in-memory limiter (logged once per process). memory: per-instance sliding window only.
# Public IP-keyed buckets (config/status, billing/webhook) are always in memory.
# Used by: src/lib/env.ts (getRateLimitBackend), src/lib/server/rate-limit.ts, scripts/live-smoke.mjs.
RATE_LIMIT_BACKEND=db

# ─── Managed by the Vercel Supabase integration (do not set by hand) ─────────
# `vercel integration add supabase` provisions the project and injects these into all three
# Vercel environments. The app reads only NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY (above) and
# SUPABASE_SERVICE_ROLE_KEY; the rest are the integration's standard set, listed here so
# `npm run env:check` recognises them instead of reporting drift. Locally you do not need any
# of them — `npx supabase start` covers development. Never commit real values.
# Aliases of the two public values (same project, different names):
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Secrets. SUPABASE_SECRET_KEY is the newer name for the service role key; SUPABASE_JWT_SECRET
# signs user tokens — neither is read by this app's code, but the integration sets both.
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
# Direct Postgres access, used by `supabase db push --db-url` and psql, not by the app.
# POSTGRES_URL_NON_POOLING is the one to use for migrations (DDL needs a session connection).
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ─── Scripts and tests (never needed by the deployed app) ────────────────────

# scripts/live-smoke.mjs: dev server origin to smoke-test. Default http://localhost:3113.
BASE_URL=http://localhost:3000

# scripts/live-smoke.mjs: credentials of a throwaway local user (created on first run).
# Defaults qa-student@example.com / password123. Only ever point these at a LOCAL stack.
SMOKE_EMAIL=qa-student@example.com
SMOKE_PASSWORD=password123

# scripts/live-smoke.mjs: set to 1 to skip the check/solve LLM streams (no OpenRouter spend).
SMOKE_SKIP_LLM=1

# Set to 1 to run the database/RLS integration tests in `npm test` against the local
# stack (they are skipped otherwise). Also see `npm run db:verify`.
RUN_DB_TESTS=

# Maths scoreboard (src/__eval__, docs/eval). Set to 1 to run the handwriting eval, which sends
# the tutor's handwriting of every corpus line to Mathpix (≤ 1500 calls per run, cached on disk,
# needs MATHPIX_APP_ID / MATHPIX_APP_KEY); skipped otherwise. `npm run eval:live` sets it.
RUN_LIVE_EVAL=
# Set to 1 to let the eval suites write their reports to docs/eval/*.{md,json}; `npm run
# eval:offline` / `eval:live` set it. Without it they only run.
EVAL_WRITE=
# Model bench (src/__eval__/models, docs/eval/models.md). Set to 1 to run it: candidate OpenRouter
# models on word-problem setup, the solve fallback and misread repair. SPENDS OPENROUTER CREDIT
# (needs OPENROUTER_API_KEY; hard cap $4.50 across runs, kept in src/__eval__/.cache/models/spend.json;
# every answer cached, so a rerun is free); skipped otherwise. `npm run eval:models` sets it.
RUN_MODEL_BENCH=
# Model bench only: at most this many items per job (e.g. 5 for a pilot); empty = all.
MODEL_BENCH_LIMIT=
# Model bench only: comma-separated OpenRouter ids to run (default: every candidate).
MODEL_BENCH_MODELS=
# Model bench only: comma-separated jobs to run, of word, fallback, repair (default: all three).
MODEL_BENCH_JOBS=
# Figure eval (src/__eval__/figures, docs/eval/figures.md). Set to 1 to run it: 47 hand-drawn figures
# through candidate vision models with the production figure prompt. SPENDS OPENROUTER CREDIT (needs
# OPENROUTER_API_KEY and rsvg-convert; hard cap $0.90 across runs, kept in
# src/__eval__/.cache/models/figures-spend.json; every answer cached); skipped otherwise. `npm run
# eval:figures` sets it.
RUN_FIGURE_EVAL=
# Figure eval only: the first this many figures (e.g. 8 for a pilot); empty = all.
FIGURE_EVAL_LIMIT=
# Figure eval only: comma-separated OpenRouter ids to run (default: the candidates in figures.test.ts).
FIGURE_EVAL_MODELS=
# Figure eval only: 0 = without the old free-form prompt as the baseline (default: with it).
FIGURE_EVAL_BASELINE=

# Board chat eval (src/__eval__/chat/chat.test.ts). Set to 1 to send the 38 chat requests through
# the candidate models with real OpenRouter calls (needs OPENROUTER_API_KEY; capped at $0.60 on
# src/__eval__/.cache/models/chat-spend.json; every reply cached); skipped otherwise. `npm run
# eval:chat` sets it.
RUN_CHAT_EVAL=
# Chat eval only: the first this many requests (e.g. 5 for a pilot); empty = all.
CHAT_EVAL_LIMIT=
# Chat eval only: comma-separated OpenRouter ids to run (default: the candidates in chat.test.ts).
CHAT_EVAL_MODELS=
# Chat eval only: comma-separated kinds of request to run (e.g. teach,help); empty = all.
CHAT_EVAL_KINDS=

# Lecture director eval (src/__eval__/lecture/lecture.test.ts). Set to 1 to send the lecture
# snippets through the candidate models with real OpenRouter calls (needs OPENROUTER_API_KEY; capped
# at LECTURE_SPEND_CAP_USD on src/__eval__/.cache/models/lecture-spend.json; every reply cached); skipped otherwise.
# `npm run eval:lecture` sets it.
RUN_LECTURE_EVAL=
# Lecture eval only: the first this many snippets (e.g. 5 for a pilot); empty = all.
LECTURE_EVAL_LIMIT=
# Lecture eval only: comma-separated snippet ids to run (e.g. `req-comic,hist-legionary`); empty = all.
LECTURE_EVAL_IDS=
# Lecture eval only: comma-separated OpenRouter ids to run (default: production's pair in lecture.test.ts).
LECTURE_EVAL_MODELS=
# Lecture eval only: how many times each snippet and sequence is sent to each model (default 3).
LECTURE_EVAL_TRIALS=
# Lecture eval only: comma-separated OpenRouter ids to run once each (a brief look beside the others' trials).
LECTURE_EVAL_ONCE=
# Lecture eval only: `sequences` runs only the multi-tick sequences (live and slides), `slides` only the
# slide lectures, `live` only the live sequences, `ticks` only the single ticks.
LECTURE_EVAL_ONLY=
# Lecture eval only: override the director's reasoning effort (e.g. `minimal`) to measure it.
LECTURE_EVAL_REASONING=
# Illustrator eval (src/__eval__/sketch/sketch.test.ts). Set to 1 to draw the corpus (panels of a
# comic, labelled diagrams, scenes) through the candidate models with real OpenRouter calls (needs
# OPENROUTER_API_KEY; capped at $4 on src/__eval__/.cache/models/sketch-spend.json; replies cached)
# and write contact sheets to docs/eval/sketch/; skipped otherwise. `npm run eval:sketch` sets it.
RUN_SKETCH_EVAL=
# Sketch eval only: comma-separated OpenRouter ids to run (default: the candidates in sketch.test.ts).
SKETCH_EVAL_MODELS=
# Sketch eval only: comma-separated case ids (a prefix matches: comic-police); empty = all.
SKETCH_EVAL_ONLY=
# Sketch eval only: the round's name (a prompt change is a new round), and what it changed.
SKETCH_EVAL_ROUND=
SKETCH_EVAL_ABOUT=
# Sketch eval only: override the illustrator's reasoning effort (e.g. `medium`) to measure it.
SKETCH_EVAL_REASONING=

# Graph gallery (src/lib/live/graphing/__tests__/gallery.test.ts). Set to 1 to write the contact
# sheet of the tutor's hand-sketched graphs to docs/graph/gallery.png (needs rsvg-convert); every
# ordinary test run builds it in memory only.
GRAPH_GALLERY=

# Figure gallery (src/lib/live/figureDraw/__tests__/gallery.test.ts). Set to 1 to write the contact
# sheet of the tutor's hand-drawn geometry figures to docs/figure/gallery.png and .svg (the PNG
# needs rsvg-convert); every ordinary test run builds it in memory only.
FIGURE_GALLERY=

# Lecture gallery (src/lib/live/lecture/__tests__/gallery.test.ts). Set to 1 to write the contact
# sheets of lecture mode's charts, diagrams, headings and notes to docs/lecture/*.png (needs
# rsvg-convert); `debug` also outlines every piece of writing. Every ordinary test run builds them in
# memory only.
LECTURE_GALLERY=

# scripts/verify-rls.mjs: email domain for the two throwaway users it signs up. Default example.com.
VERIFY_EMAIL_DOMAIN=

# ─── Billing (credits + plans; all optional) ─────────────────────────────────
# Design: docs/ARCHITECTURE.md "Billing". Plan numbers in the migration are PLACEHOLDERS.

# Set to 0 to skip credit consumption on the server (dev/staging escape hatch; logged once).
# Anything else, including unset, meters every paid route. Used by: src/lib/env.ts (billingEnforced),
# src/lib/server/billing.ts. Default 1.
BILLING_ENFORCE=1

# Signing secret of the billing provider's webhook endpoint (Stripe-compatible
# `Stripe-Signature: t=…,v1=…`). Used by: src/app/api/billing/webhook. Empty -> the
# webhook answers 503 feature_unavailable. NOTE: the webhook also needs SUPABASE_SERVICE_ROLE_KEY
# (above) to change plans; the only other request path using the service role is /api/admin/gc.
STRIPE_WEBHOOK_SECRET=

# JSON map from provider price id to plan id, e.g. {"price_123":"plus","price_456":"pro"}.
# Printed by scripts/stripe-setup.mjs (docs/RUNBOOK-billing.md). Used by: src/lib/env.ts
# (getBillingPriceMap), src/app/api/billing/webhook. Empty -> checkouts still set the plan (from the
# Payment Link's metadata.plan_id), but a plan switch in the customer portal is not picked up.
# Invalid JSON -> the webhook answers 503.
BILLING_PRICE_MAP=

# JSON with checkout links per plan id plus the customer portal, e.g.
# {"plus":"https://buy.stripe.com/…","pro":"https://buy.stripe.com/…","portal":"https://billing.stripe.com/p/login/…"}.
# Printed by scripts/stripe-setup.mjs. Public: read by the /account page, the board's
# out-of-credits dialog and the 402 `upgradeUrl`. Empty -> plans show "Coming soon".
# Used by: src/lib/env.ts (getBillingLinks), src/lib/billing/links.ts.
NEXT_PUBLIC_BILLING_LINKS=
