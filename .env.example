# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in YOUR OWN credentials.
#
# This project is bring-your-own-key. No API keys are distributed with the
# source. Every AI call is billed to whoever runs the instance.
#
# `.env*` is gitignored — never commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# --- AI providers ----------------------------------------------------------

# REQUIRED. Powers solution/hint generation, worksheet generation, automatic
# "needs help" detection, voice workspace analysis, and the credits display.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OPTIONAL. Only needed for the realtime voice tutor. Without it, the voice
# feature is disabled and the rest of the app works normally.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL. Only needed for handwriting / PDF OCR.
# Get one at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- Database / auth (Supabase) -------------------------------------------

# Create your own project at https://supabase.com — do not point at someone
# else's instance.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Canvas SDK ------------------------------------------------------------

# The tldraw SDK is licensed separately from this project and REQUIRES its own
# license key for any production deployment (commercial license for commercial
# use, free hobby license for non-commercial use). Development on localhost
# works without a key. Request one at https://tldraw.dev/community/license
# This value is validated client-side and is safe to expose publicly.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# --- App -------------------------------------------------------------------

# Your deployment's public origin. Sent to OpenRouter as the referer header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# trace | debug | info | warn | error
LOG_LEVEL=info
