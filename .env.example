# Copy to .env.local for local development. Never commit .env.local.
# Server-only keys (no NEXT_PUBLIC_ prefix) are read only inside route handlers.

# ─── Required ─────────────────────────────────────────────────────────────────
# Supabase project URL + anon key (Dashboard -> Project Settings -> API).
# For a local stack these come from `npx supabase start` / `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenRouter: every AI route (solution/feedback images, worksheets, workspace
# analysis, credits). https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ─── Optional ─────────────────────────────────────────────────────────────────
# OpenAI: voice tutor only (Realtime API over WebRTC). Without it
# /api/voice/token returns 503 voice_unavailable and the mic button is hidden.
OPENAI_API_KEY=

# Mathpix: handwritten math -> LaTeX OCR. Without it the app falls back to the
# vision model reading the canvas image. https://mathpix.com
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Supabase service role key. Server-only. Not used by any route yet; reserved
# for future admin jobs (asset garbage collection, trainer management).
SUPABASE_SERVICE_ROLE_KEY=

# tldraw license key (removes the watermark). Leave blank for development.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Public origin of the deployment. Sent as HTTP-Referer to OpenRouter.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
